# =============================================================================
# Interview Simulator Frontend - Production Environment Variables
# Automatically loaded by Vite for production builds (npm run build)
# =============================================================================

# Backend API URL (Railway production)
VITE_API_URL=https://interview-simulator-api-production.up.railway.app/api/v1

# Forge Core URL (when migrated to unified auth)
VITE_FORGE_CORE_URL=https://api.codeswiftr.com

# PostHog Analytics
# Note: The actual key is set in Railway/Cloudflare environment
# This placeholder is used during local development with production config
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Rewardful Affiliate Tracking (optional - disabled if not set)
# Get your API key from https://dashboard.getrewardful.com/settings
VITE_REWARDFUL_API_KEY=
