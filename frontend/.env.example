# =============================================================================
# Interview Simulator Frontend - Environment Variables
# Copy to .env: cp .env.example .env
# =============================================================================

# Backend API URL (Interview Simulator backend on port 8001)
# Local: http://localhost:8001/api/v1
# Production: https://interview-simulator-api-production.up.railway.app/api/v1
VITE_API_URL=http://localhost:8001/api/v1

# Forge Core URL (auth/billing - when migrated to unified auth)
# Local: http://localhost:8000
# Production: https://api.codeswiftr.com
VITE_FORGE_CORE_URL=http://localhost:8000
