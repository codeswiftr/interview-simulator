# =============================================================================
# Interview Simulator - Local Development Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Usage: docker compose -f docker-compose.yml --env-file .env up

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=interview_simulator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PORT=6379

# =============================================================================
# Backend Configuration
# =============================================================================
BACKEND_PORT=8000
SECRET_KEY=dev_secret_key_change_in_production_32_chars_minimum
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Frontend Configuration
# =============================================================================
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# =============================================================================
# AI Services (Optional for local development)
# =============================================================================
# Transcription Provider: groq, openai, or whisper
TRANSCRIPTION_PROVIDER=groq

# Groq (Recommended for fast, free transcription)
GROQ_API_KEY=

# OpenAI (Alternative for transcription and analysis)
OPENAI_API_KEY=

# Content Analysis Provider: openrouter, anthropic, or openai
CONTENT_ANALYSIS_PROVIDER=openrouter

# OpenRouter (Recommended for cost-effective Claude access)
OPENROUTER_API_KEY=

# Anthropic (Direct Claude API access)
ANTHROPIC_API_KEY=

# =============================================================================
# Stripe (Optional for local development)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_ANNUAL=

# =============================================================================
# Email Service (Optional for local development)
# =============================================================================
# Resend (for password reset emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=dev@localhost

# =============================================================================
# Analytics (Optional for local development)
# =============================================================================
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# CORS Configuration (Permissive for development)
# =============================================================================
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# =============================================================================
# Development Settings
# =============================================================================
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=DEBUG
