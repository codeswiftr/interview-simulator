# =============================================================================
# Interview Simulator - Staging Environment Variables
# Copy to .env.staging and fill in your values: cp .env.staging.example .env.staging
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Interview Simulator Staging"
ENVIRONMENT=staging

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=interview_simulator_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_32_CHARS
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_MIN_32_CHARS
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Security - CRITICAL: Change all secrets before deploying!
# Generate secure key: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# AI Services
# Get keys from respective provider dashboards
# -----------------------------------------------------------------------------
# Transcription (choose one provider)
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=                    # Recommended: Fast, free tier available
OPENAI_API_KEY=                  # Alternative: OpenAI Whisper

# Content Analysis (choose one provider)
CONTENT_ANALYSIS_PROVIDER=openrouter
OPENROUTER_API_KEY=              # Recommended: Access to multiple models
ANTHROPIC_API_KEY=               # Alternative: Direct Anthropic Claude

# -----------------------------------------------------------------------------
# Stripe Payments (optional - for subscriptions)
# Use TEST keys for staging: https://dashboard.stripe.com/test/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_PRICE_ID_PRO_ANNUAL=price_...

# -----------------------------------------------------------------------------
# Email - Resend (required for password reset)
# Get API key from: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...

# IMPORTANT: Use a VERIFIED domain in Resend dashboard
# - For staging, you can use your production domain or a staging subdomain
# - DO NOT use "onboarding@resend.dev" (sandbox only, limited to your email)
# - Example: hello@staging.codeswiftr.com or staging@codeswiftr.com
RESEND_FROM_EMAIL=hello@staging.codeswiftr.com
RESEND_FROM_NAME=Interview Simulator Staging

# Frontend URL for email links (password reset, verification)
# Should match your staging frontend URL
FRONTEND_URL=http://staging.codeswiftr.com

# -----------------------------------------------------------------------------
# CORS - Allowed frontend origins (JSON array)
# Add your staging domain(s)
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost", "http://staging.codeswiftr.com", "https://staging.codeswiftr.com"]

# -----------------------------------------------------------------------------
# Analytics - PostHog (optional)
# Get API key from: https://app.posthog.com/project/settings
# -----------------------------------------------------------------------------
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Error Monitoring - Sentry (optional)
# Get DSN from: https://sentry.io/settings/projects/
# -----------------------------------------------------------------------------
SENTRY_DSN=https://...@sentry.io/...

# -----------------------------------------------------------------------------
# Service Ports (exposed to host)
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=80

# -----------------------------------------------------------------------------
# Vite Build Arguments (for frontend container build)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
# For production staging: VITE_API_URL=https://api-staging.codeswiftr.com/api/v1
