# =============================================================================
# Interview Simulator Frontend - Production Dockerfile
# Multi-stage build: Node.js build + Nginx serve
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Builder - Build React application with Vite
# -----------------------------------------------------------------------------
FROM node:22-alpine AS builder

# Set working directory
WORKDIR /build

# Copy package files for dependency installation
COPY package*.json ./

# Install dependencies (production + dev for build)
RUN npm ci

# Copy application source
COPY . .

# Build arguments for environment variables (injected at build time)
ARG VITE_API_URL
ARG VITE_APP_ENV=staging

# Set environment variables for Vite build
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_APP_ENV=${VITE_APP_ENV}

# Build application
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: Runtime - Nginx for serving static files
# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx configuration
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx-site.conf /etc/nginx/conf.d/default.conf

# Copy built application from builder
COPY --from=builder /build/dist /usr/share/nginx/html

# Copy offline page for PWA
RUN echo '<!DOCTYPE html><html><head><title>Offline</title></head><body><h1>You are offline</h1><p>Please check your connection.</p></body></html>' \
    > /usr/share/nginx/html/offline.html

# Create nginx user for non-root operation
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/api/v1/health || curl -f http://localhost/ || exit 1

# Run as non-root user
USER nginx

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
