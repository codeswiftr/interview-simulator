# Application
APP_NAME="Interview Simulator"
DEBUG=true
ENVIRONMENT="development"

# Database (matches docker-compose)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/interview_simulator"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Security - CHANGE IN PRODUCTION
SECRET_KEY="change-me-in-production-use-32-chars-min"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Services - Required for production
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Stripe - Required for subscriptions
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO_MONTHLY=""
STRIPE_PRICE_ID_PRO_ANNUAL=""

# CORS - Update for production domains
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# Storage
STORAGE_BUCKET="interview-simulator-media"
STORAGE_URL=""
