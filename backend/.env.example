# =============================================================================
# Interview Simulator Backend - Environment Variables
# Copy to .env and fill in your values: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Interview Simulator"
DEBUG=true
ENVIRONMENT="development"

# -----------------------------------------------------------------------------
# Database (matches docker-compose.yml defaults)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/interview_simulator"

# -----------------------------------------------------------------------------
# Redis (optional - for caching/rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# -----------------------------------------------------------------------------
# Security
# Generate a secure key: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY="dev-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# AI Services
# Get keys from: https://platform.openai.com/api-keys
#                https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
# Required for audio transcription (Whisper)
OPENAI_API_KEY=""

# Required for AI feedback generation (Claude)
ANTHROPIC_API_KEY=""

# -----------------------------------------------------------------------------
# Stripe Payments (optional - for subscriptions)
# Get keys from: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO_MONTHLY=""
STRIPE_PRICE_ID_PRO_ANNUAL=""

# -----------------------------------------------------------------------------
# CORS - Allowed frontend origins (JSON array)
# -----------------------------------------------------------------------------
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# -----------------------------------------------------------------------------
# Email - Resend (required for password reset)
# Get API key from: https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=""

# IMPORTANT: RESEND_FROM_EMAIL must be from a VERIFIED domain in Resend dashboard
# - Go to https://resend.com/domains and verify your domain first
# - DO NOT use "onboarding@resend.dev" in production (sandbox only)
# - Example verified domains: hello@yourdomain.com, noreply@yourdomain.com
RESEND_FROM_EMAIL="hello@codeswiftr.com"
RESEND_FROM_NAME="Interview Simulator"

# Frontend URL for email links (password reset, verification)
# Must match your deployed frontend URL in production
FRONTEND_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# Storage (local file storage in development)
# -----------------------------------------------------------------------------
STORAGE_BUCKET="interview-simulator-media"
STORAGE_URL=""

# -----------------------------------------------------------------------------
# Analytics - PostHog (optional)
# Get API key from: https://app.posthog.com/project/settings
# -----------------------------------------------------------------------------
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"
