meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users/register
  body: json
  auth: none
}

body:json {
  {
    "email": "test@example.com",
    "password": "testpassword123",
    "full_name": "Test User"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("userId", res.body.id);
  }
}
