# =============================================================================
# Interview Simulator Backend — Production Environment Variables
# For Railway deployment. Copy to .env or set via `railway variables set`.
# =============================================================================

# -- Application --
APP_NAME="Interview Simulator"
DEBUG=false
ENVIRONMENT="production"

# -- Database (Railway PostgreSQL) --
# Provided automatically by Railway when you add a PostgreSQL service.
# Format: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=  # REQUIRED — Railway auto-injects this

# -- Redis (Railway Redis service) --
# Provided automatically by Railway when you add a Redis service.
REDIS_URL=  # REQUIRED — used for rate limiting + caching

# -- Security --
# Generate: openssl rand -hex 32
SECRET_KEY=  # REQUIRED — min 32 chars, never reuse across environments

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -- AI Services --
# OpenAI: https://platform.openai.com/api-keys (for Whisper transcription)
OPENAI_API_KEY=  # REQUIRED — audio transcription

# Anthropic: https://console.anthropic.com/settings/keys (for Claude feedback)
ANTHROPIC_API_KEY=  # REQUIRED — AI feedback generation

# -- Stripe Payments --
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=  # OPTIONAL (free tier works without)
STRIPE_WEBHOOK_SECRET=  # OPTIONAL — create webhook at https://dashboard.stripe.com/webhooks
STRIPE_PRICE_ID_PRO_MONTHLY=  # Create in Stripe: Products → Interview Simulator Pro Monthly
STRIPE_PRICE_ID_PRO_ANNUAL=  # Create in Stripe: Products → Interview Simulator Pro Annual

# -- CORS --
# JSON array of allowed frontend origins
CORS_ORIGINS='["https://app.codeswiftr.com"]'

# -- Email (Resend) --
# API key: https://resend.com/api-keys
# IMPORTANT: Verify codeswiftr.com domain at https://resend.com/domains first
RESEND_API_KEY=  # REQUIRED — password reset + email verification
RESEND_FROM_EMAIL="hello@codeswiftr.com"
RESEND_FROM_NAME="Interview Simulator"

# Frontend URL for email links (password reset, verification)
FRONTEND_URL="https://app.codeswiftr.com"

# -- Analytics --
# PostHog: https://app.posthog.com/project/settings
POSTHOG_API_KEY=  # OPTIONAL — event tracking
POSTHOG_HOST="https://app.posthog.com"

# -- Sentry --
# https://sentry.io/settings/projects/
SENTRY_DSN=  # OPTIONAL — error tracking
