# =============================================================================
# SECURITY WARNING: This file should NEVER be committed to git!
# Run: git rm --cached .env
# Copy values from .env.example and fill in your own keys
# =============================================================================

# Application
app_name="Interview Simulator"
debug=true
environment="development"

# Database (matches FORGE docker-compose.local.yml)
database_url="postgresql+asyncpg://forge:forge_local@localhost:5432/interview_simulator"

# Redis
redis_url="redis://localhost:6379/0"

# Security
secret_key="change-me-to-a-secure-random-string"
access_token_expire_minutes=30
refresh_token_expire_days=7

# AI Services - Get your own keys!
anthropic_api_key=""
openai_api_key=""
openrouter_api_key=""
groq_api_key=""

# AI Provider Selection
transcription_provider="groq"
content_analysis_provider="openrouter"

# CORS
cors_origins='["http://localhost:3000", "http://localhost:5173", "http://localhost:5174", "http://localhost:5175", "http://localhost:5176", "http://127.0.0.1:3000", "http://127.0.0.1:5173", "http://127.0.0.1:5174", "http://127.0.0.1:5175", "http://127.0.0.1:5176"]'

# Storage
storage_bucket="interview-simulator-media"
storage_url=""

# Stripe Payments - Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO_MONTHLY=""
